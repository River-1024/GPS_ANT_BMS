<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/dashboardRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_dashboard_root"
    android:padding="10dp"
    tools:context=".DashboardActivity">

    <LinearLayout
        android:id="@+id/topMetricsRow"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@id/powerPanel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.43"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <GridLayout
            android:id="@+id/leftMetricGrid"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:alignmentMode="alignBounds"
            android:columnCount="2"
            android:rowCount="2"
            android:useDefaultMargins="false">

            <FrameLayout style="@style/DashboardMetricTile">
                <TextView
                    android:id="@+id/textRemaining"
                    style="@style/DashboardMetricValue"
                    android:text="121.40Ah" />
            </FrameLayout>

            <FrameLayout style="@style/DashboardMetricTile">
                <TextView
                    android:id="@+id/textRange"
                    style="@style/DashboardMetricValue"
                    android:text="182.1km" />
            </FrameLayout>

            <FrameLayout style="@style/DashboardMetricTile">
                <TextView
                    android:id="@+id/textPowerMetric"
                    style="@style/DashboardMetricValue"
                    android:text="8W" />
            </FrameLayout>

            <FrameLayout style="@style/DashboardMetricTile">
                <TextView
                    android:id="@+id/textCurrent"
                    style="@style/DashboardMetricValue"
                    android:text="0.0A" />
            </FrameLayout>
        </GridLayout>

        <FrameLayout
            android:id="@+id/socPanel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp"
            android:layout_weight="0.48">

            <com.zjsf.gps_ant_bms.ui.SocFillView
                android:id="@+id/socFillView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <TextView
                android:id="@+id/textSoc"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="92%"
                android:textColor="#07110B"
                android:textSize="76sp"
                android:textStyle="bold" />
        </FrameLayout>

        <GridLayout
            android:id="@+id/rightMetricGrid"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:alignmentMode="alignBounds"
            android:columnCount="2"
            android:rowCount="2"
            android:useDefaultMargins="false">

            <FrameLayout style="@style/DashboardMetricTile">
                <TextView
                    android:id="@+id/textVoltage"
                    style="@style/DashboardMetricValue"
                    android:text="81.18V" />
            </FrameLayout>

            <FrameLayout style="@style/DashboardMetricTile">
                <GridLayout
                    android:id="@+id/tempGrid"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:alignmentMode="alignBounds"
                    android:columnCount="2"
                    android:padding="5dp"
                    android:rowCount="2"
                    android:useDefaultMargins="false">

                    <TextView
                        android:id="@+id/textTempMos"
                        style="@style/DashboardTempValue"
                        android:text="35°" />

                    <TextView
                        android:id="@+id/textTempBalancer"
                        style="@style/DashboardTempValue"
                        android:text="37°" />

                    <TextView
                        android:id="@+id/textTempSensor1"
                        style="@style/DashboardTempValue"
                        android:text="34°" />

                    <TextView
                        android:id="@+id/textTempSensor2"
                        style="@style/DashboardTempValue"
                        android:text="34°" />
                </GridLayout>
            </FrameLayout>

            <FrameLayout style="@style/DashboardMetricTile">
                <TextView
                    android:id="@+id/textSoh"
                    style="@style/DashboardMetricValue"
                    android:text="100%" />
            </FrameLayout>

            <FrameLayout style="@style/DashboardMetricTile">
                <TextView
                    android:id="@+id/textVoltageDiff"
                    style="@style/DashboardMetricValue"
                    android:text="7mV" />
            </FrameLayout>
        </GridLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/powerPanel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_dashboard_panel"
        android:orientation="vertical"
        android:padding="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topMetricsRow">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/textPower"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.8"
                android:includeFontPadding="false"
                android:text="8W"
                android:textColor="#39E36C"
                android:textSize="34sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textBleStatus"
                style="@style/DashboardStatusText"
                android:text="预览模式" />

            <TextView
                android:id="@+id/textGpsStatus"
                style="@style/DashboardStatusText"
                android:text="GPS 预览" />

            <TextView
                android:id="@+id/textUpdateTime"
                style="@style/DashboardStatusText"
                android:text="未连接保护板" />

            <TextView
                android:id="@+id/buttonPowerBar"
                style="@style/DashboardToggleButton"
                android:text="功率条" />

            <TextView
                android:id="@+id/buttonPowerChart"
                style="@style/DashboardToggleButton"
                android:layout_marginStart="4dp"
                android:text="曲线图" />

            <TextView
                android:id="@+id/buttonBack"
                style="@style/DashboardToggleButton"
                android:layout_marginStart="8dp"
                android:text="返回" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/powerVisualContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="5dp"
            android:layout_weight="1"
            android:background="@drawable/bg_dashboard_chart">

            <com.zjsf.gps_ant_bms.ui.PowerBarView
                android:id="@+id/powerBarView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="12dp" />

            <com.zjsf.gps_ant_bms.ui.PowerChartView
                android:id="@+id/powerChartView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="8dp"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
