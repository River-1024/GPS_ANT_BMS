<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.GPS_ANT_BMS" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#39E36C</item>
        <item name="colorPrimary">#39E36C</item>
        <item name="colorOnPrimary">#07110B</item>
        <item name="colorSurface">#151D1B</item>
        <item name="colorOnSurface">#F3FAF7</item>
        <item name="android:navigationBarColor">#0C1110</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.GPS_ANT_BMS" parent="Base.Theme.GPS_ANT_BMS" />

    <style name="Theme.GPS_ANT_BMS.Dashboard" parent="Theme.GPS_ANT_BMS">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
    </style>

    <style name="DashboardMetricTile">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_rowWeight">1</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:background">@drawable/bg_dashboard_panel</item>
        <item name="android:padding">6dp</item>
    </style>

    <style name="DashboardMetricValue">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:ellipsize">none</item>
        <item name="android:fitsSystemWindows">false</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">#F3FAF7</item>
        <item name="android:textSize">32sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="DashboardTempValue" parent="DashboardMetricValue">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_rowWeight">1</item>
        <item name="android:layout_margin">3dp</item>
        <item name="android:background">@drawable/bg_dashboard_temp_chip</item>
        <item name="android:textColor">#F4C85A</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="DashboardToggleButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:minWidth">70dp</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:background">@drawable/bg_dashboard_button</item>
        <item name="android:textColor">#F4FFFB</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="DashboardStatusText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">9dp</item>
        <item name="android:textColor">#8FA29C</item>
        <item name="android:textSize">11sp</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="DashboardSettingsLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:textColor">#8FA29C</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="DashboardSettingsHint">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:textColor">#8FA29C</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="DashboardSettingsInput">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">42dp</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:background">@drawable/bg_dashboard_input</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">#F3FAF7</item>
        <item name="android:textColorHint">#5F716C</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="DashboardSettingsSpinner">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">42dp</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:background">@drawable/bg_dashboard_input</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
    </style>

    <style name="DashboardSettingsButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:background">@drawable/bg_dashboard_button</item>
        <item name="android:textColor">#F3FAF7</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
</resources>
