<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape>
            <solid android:color="#39E36C" />
            <stroke
                android:width="0dp"
                android:color="#39E36C" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#101715" />
            <stroke
                android:width="1dp"
                android:color="#1FE8F6F1" />
            <corners android:radius="6dp" />
        </shape>
    </item>
</selector>
